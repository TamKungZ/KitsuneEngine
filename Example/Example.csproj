<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!--
    Example setup for developers using KitsuneEngine from source.
    If using NuGet, replace these ProjectReference items with PackageReference.
  -->
  <ItemGroup>
    <ProjectReference Include="..\KitsuneEngine.Core\KitsuneEngine.Core.csproj" />
    <ProjectReference Include="..\KitsuneEngine.Graphics\KitsuneEngine.Graphics.csproj" />
    <ProjectReference Include="..\KitsuneEngine.Input\KitsuneEngine.Input.csproj" />
    <ProjectReference Include="..\KitsuneEngine.Assets\KitsuneEngine.Assets.csproj" />
    <ProjectReference Include="..\KitsuneEngine.Audio\KitsuneEngine.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="AssetsSource\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
