<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Optimize>true</Optimize>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Company>TamKungZ_</Company>
		<Authors>TamKungZ_</Authors>
		<Product>KitsuneEngine.Assets</Product>
		<Description>Asset management system with KPAK file format support.</Description>
		<Version>1.0.0</Version>
		<AssemblyName>KitsuneEngine.Assets</AssemblyName>
		<RootNamespace>KitsuneEngine.Assets</RootNamespace>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="K4os.Compression.LZ4" Version="1.*" />
		<PackageReference Include="StbImageSharp" Version="2.*" />
		<PackageReference Include="Silk.NET.OpenGL" Version="2.*" />
		<PackageReference Include="Silk.NET.OpenAL" Version="2.*" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.*" />
		
		<PackageReference Include="Fasterflect" Version="3.*" />
		<PackageReference Include="Collections.Pooled.V2" Version="2.*" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\KitsuneEngine.Graphics\KitsuneEngine.Graphics.csproj" />
		<ProjectReference Include="..\KitsuneEngine.Audio\KitsuneEngine.Audio.csproj" />
	</ItemGroup>
</Project>
