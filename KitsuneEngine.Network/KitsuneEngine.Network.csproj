<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>
		<Optimize>true</Optimize>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Company>TamKungZ_</Company>
		<Authors>TamKungZ_</Authors>
		<Product>KitsuneEngine.Network</Product>
		<Description>Networking system with LiteNetLib for multiplayer games.</Description>
		<Version>1.0.0</Version>
		<AssemblyName>KitsuneEngine.Network</AssemblyName>
		<RootNamespace>KitsuneEngine.Network</RootNamespace>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="LiteNetLib" Version="1.*" />
		<PackageReference Include="MessagePack" Version="3.*" />
		<PackageReference Include="DefaultEcs" Version="0.17.*" />
		<PackageReference Include="ENet-CSharp" Version="2.*" />
		<PackageReference Include="System.Numerics.Vectors" Version="4.*" />
	</ItemGroup>
</Project>
